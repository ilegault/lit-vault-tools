.DS_Store
Thumbs.db

# Planning scratch that must NOT reach a reviewer.
# .scratch/ is deliberately NOT here: ticket files travel with the branch,
# so a draft PR is a complete handoff. See docs/agents/issue-tracker.md
.claude/
.agents
